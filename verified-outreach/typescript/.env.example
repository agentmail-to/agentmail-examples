# --- API keys -----------------------------------------------------------------
AGENTMAIL_API_KEY=am_us_...
# Get one at https://app.mailveri.com/api-keys/
MAILVERI_API_KEY=your_mailveri_api_key


# --- Sender identity ----------------------------------------------------------
SENDER_NAME=Jane Doe
SENDER_COMPANY=Acme


# --- Verification policy ------------------------------------------------------
# VALID is always sent. INVALID, DISPOSABLE and FULL_INBOX are always skipped.
# ROLE_ACCOUNT (info@, sales@) and CATCH_ALL (domain accepts everything) are
# held for review by default. Flip to true to send to them anyway.
SEND_ROLE_ACCOUNTS=false
SEND_CATCH_ALL=false


# --- Tuning -------------------------------------------------------------------
# Verify and log, but don't send anything. Verification still uses credits.
DRY_RUN=false
# MailVeri single-verify is rate limited to 1 request/second.
VERIFY_INTERVAL_SECONDS=1.1
# MAILVERI_BASE_URL=https://api.mailveri.com

# Optional: pin a username for the inbox (default: random)
# INBOX_USERNAME=outreach
